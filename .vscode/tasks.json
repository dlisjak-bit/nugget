{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Nugget: physics lab",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"},
      "args": ["run_lab.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated"}
    },
    {
      "label": "Nugget: pinned joint explorer",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"},
      "args": ["run_lab.py", "--bench"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Nugget: check model",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"},
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Nugget: rebuild CAD visuals",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {"command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"},
      "args": ["scripts/build_model.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
